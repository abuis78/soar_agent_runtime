    "configuration": {
        "anthropic_api_key": {
            "description": "Anthropic API Key (for Claude models)",
            "data_type": "password",
            "required": false,
            "order": 0
        },
        "anthropic_api_url": {
            "description": "Anthropic API URL (default: https://api.anthropic.com)",
            "data_type": "string",
            "required": false,
            "default": "https://api.anthropic.com",
            "order": 1
        },
        "openai_api_key": {
            "description": "OpenAI API Key (for GPT models)",
            "data_type": "password",
            "required": false,
            "order": 2
        },
        "openai_api_url": {
            "description": "OpenAI API URL (default: https://api.openai.com/v1)",
            "data_type": "string",
            "required": false,
            "default": "https://api.openai.com/v1",
            "order": 3
        },
        "gemini_api_key": {
            "description": "Google Gemini API Key",
            "data_type": "password",
            "required": false,
            "order": 4
        },
        "local_llm_url": {
            "description": "Local LLM base URL (Ollama: http://localhost:11434/v1)",
            "data_type": "string",
            "required": false,
            "default": "http://localhost:11434/v1",
            "order": 5
        },
        "local_llm_api_key": {
            "description": "Local LLM API Key (use 'ollama' for Ollama, or leave empty)",
            "data_type": "password",
            "required": false,
            "order": 6
        },
        "local_llm_model": {
            "description": "Local LLM model used when the agent definition names none, and by test connectivity (Ollama: the tag from 'ollama list', e.g. qwen2.5:7b)",
            "data_type": "string",
            "required": false,
            "default": "llama3",
            "order": 7
        },
        "default_provider": {
            "description": "Default LLM provider if not specified in agent definition (anthropic | openai | gemini | local)",
            "data_type": "string",
            "required": false,
            "default": "anthropic",
            "order": 8
        },
        "default_max_steps": {
            "description": "Default maximum ReAct loop steps per agent run",
            "data_type": "numeric",
            "required": false,
            "default": 25,
            "order": 9
        },
        "agent_list_name": {
            "description": "SOAR Custom List name containing agent definitions",
            "data_type": "string",
            "required": false,
            "default": "agent_definitions",
            "order": 10
        },
        "telemetry_enabled": {
            "description": "Send agent_action telemetry events to Splunk HEC (AI-SOC Telemetry). Off by default; agent behaviour is unaffected either way.",
            "data_type": "boolean",
            "required": false,
            "default": false,
            "order": 11
        },
        "hec_url": {
            "description": "Splunk HEC event endpoint, e.g. https://splunk.example.com:8088/services/collector/event",
            "data_type": "string",
            "required": false,
            "order": 12
        },
        "hec_token": {
            "description": "Splunk HEC token, scoped to the ai_soc_audit index",
            "data_type": "password",
            "required": false,
            "order": 13
        },
        "telemetry_index": {
            "description": "Splunk index for telemetry events",
            "data_type": "string",
            "required": false,
            "default": "ai_soc_audit",
            "order": 14
        },
        "telemetry_verify_tls": {
            "description": "Verify the HEC TLS certificate. Disable only for a self-signed test instance.",
            "data_type": "boolean",
            "required": false,
            "default": true,
            "order": 15
        },
        "skill_list_name": {
            "description": "SOAR Custom List name containing skill definitions",
            "data_type": "string",
            "required": false,
            "default": "agent_skills",
            "order": 16
        },
        "airgap_mode": {
            "description": "Air-gap mode (RT-A01). When enabled only the 'local' provider is allowed, cloud providers are rejected at run start, free-form SPL is disabled and read/act tools go through Tool Broker and Policy Manager. Off = current behaviour.",
            "data_type": "boolean",
            "required": false,
            "default": false,
            "order": 17
        },
        "llm_timeout_s": {
            "description": "Timeout in seconds for a single model call (RT-A03)",
            "data_type": "numeric",
            "required": false,
            "default": 120,
            "order": 18
        },
        "llm_temperature": {
            "description": "Sampling temperature for model calls; 0 = as deterministic as the model allows (RT-A03)",
            "data_type": "numeric",
            "required": false,
            "default": 0,
            "order": 19
        },
        "llm_max_tokens": {
            "description": "Maximum output tokens per model call (RT-A03)",
            "data_type": "numeric",
            "required": false,
            "default": 4096,
            "order": 20
        },
        "llm_seed": {
            "description": "Optional sampling seed, sent only if set and only if the inference server supports it (RT-A03). Leave empty to not send a seed.",
            "data_type": "numeric",
            "required": false,
            "order": 21
        },
        "max_observation_chars": {
            "description": "Maximum characters of a single tool observation, extra_context block or container payload passed to the model; longer input is truncated and marked (RT-B04)",
            "data_type": "numeric",
            "required": false,
            "default": 8000,
            "order": 22
        },
        "audit_enabled": {
            "description": "Write one audit artifact (label agent_audit) per agent step to the case (RT-P02). Always on and fail-closed in airgap_mode.",
            "data_type": "boolean",
            "required": false,
            "default": false,
            "order": 23
        },
        "broker_url": {
            "description": "Tool Broker base URL, https only (mTLS, RT-L07). Required in airgap_mode: read tools come from the broker.",
            "data_type": "string",
            "required": false,
            "order": 24
        },
        "broker_timeout_s": {
            "description": "Timeout in seconds for every Tool Broker call (RT-L07)",
            "data_type": "numeric",
            "required": false,
            "default": 30,
            "order": 25
        },
        "broker_client_cert": {
            "description": "Path on the SOAR host to the client certificate (PEM) presented to the Tool Broker (mTLS)",
            "data_type": "string",
            "required": false,
            "order": 26
        },
        "broker_client_key": {
            "description": "Path on the SOAR host to the private key (PEM) for the client certificate; the key never leaves the host",
            "data_type": "string",
            "required": false,
            "order": 27
        },
        "broker_ca": {
            "description": "Path on the SOAR host to the CA bundle (PEM) that signed the Tool Broker server certificate",
            "data_type": "string",
            "required": false,
            "order": 28
        },
        "policy_mode": {
            "description": "Policy Manager mode for effecting actions (RT-W03): 'embedded' (policy_client in-process, policy_path + policy_state_dir) or 'service' (Policy Manager service over mTLS, policy_service_url + certificate fields). Empty = every effecting action is denied in airgap_mode",
            "data_type": "string",
            "required": false,
            "value_list": [
                "",
                "embedded",
                "service"
            ],
            "default": "",
            "order": 29
        },
        "policy_path": {
            "description": "Path on the SOAR host to the policy file (JSON/TOML from Git) used by policy_mode 'embedded' (E11)",
            "data_type": "string",
            "required": false,
            "order": 30
        },
        "policy_state_dir": {
            "description": "Directory on the SOAR host for the embedded Policy Manager state: approvals.json, halt.json, audit.jsonl (E11). Must be writable by the app user",
            "data_type": "string",
            "required": false,
            "order": 31
        },
        "policy_service_url": {
            "description": "Policy Manager service base URL, https only (mTLS, RT-W01). Only policy_mode 'service'",
            "data_type": "string",
            "required": false,
            "order": 32
        },
        "policy_timeout_s": {
            "description": "Timeout in seconds for every Policy Manager service call; on timeout the action is denied, no fallback (RT-W04). Only policy_mode 'service'",
            "data_type": "numeric",
            "required": false,
            "default": 5,
            "order": 33
        },
        "policy_client_cert": {
            "description": "Path on the SOAR host to the client certificate (PEM) presented to the Policy Manager service; its CN is the client identity. Only policy_mode 'service'",
            "data_type": "string",
            "required": false,
            "order": 34
        },
        "policy_client_key": {
            "description": "Path on the SOAR host to the private key (PEM) for the Policy Manager client certificate; the key never leaves the host. Only policy_mode 'service'",
            "data_type": "string",
            "required": false,
            "order": 35
        },
        "policy_ca": {
            "description": "Path on the SOAR host to the CA bundle (PEM) that signed the Policy Manager server certificate. Only policy_mode 'service'",
            "data_type": "string",
            "required": false,
            "order": 36
        }
    },
    "actions": [
        {
            "action": "test connectivity",
            "identifier": "test_connectivity",
            "description": "Validates connectivity to all configured LLM providers",
            "type": "test",
            "read_only": true,
            "parameters": {},
            "output": [],
            "versions": "EQ(*)"
        },
        {
            "action": "run agent",
            "identifier": "run_agent",
            "description": "Runs a named agent using the ReAct loop against a given task and container",
            "type": "generic",
            "read_only": false,
            "parameters": {
                "agent_id": {
                    "description": "Agent identifier as defined in the agent_definitions Custom List",
                    "data_type": "string",
                    "required": true,
                    "order": 0
                },
                "task": {
                    "description": "Natural language task description for the agent",
                    "data_type": "string",
                    "required": true,
                    "order": 1
                },
                "container_id": {
                    "description": "SOAR Container ID the agent operates on",
                    "data_type": "numeric",
                    "required": true,
                    "order": 2
                },
                "max_steps": {
                    "description": "Override default max ReAct loop steps (0 = use app default)",
                    "data_type": "numeric",
                    "required": false,
                    "default": 0,
                    "order": 3
                },
                "extra_context": {
                    "description": "Optional JSON string with additional context passed to the agent",
                    "data_type": "string",
                    "required": false,
                    "order": 4
                },
                "stufe": {
                    "description": "Escalation stage 0-4 of the triggering playbook, sent with every policy request (RT-W08); empty = unknown",
                    "data_type": "numeric",
                    "required": false,
                    "order": 5
                },
                "domaene": {
                    "description": "Domain of this run (e.g. soc, it, ot), sent with every policy request (RT-W08)",
                    "data_type": "string",
                    "required": false,
                    "order": 6
                }
            },
            "output": [
                {
                    "data_path": "action_result.data.*.agent_id",
                    "data_type": "string",
                    "column_name": "Agent ID",
                    "column_order": 0
                },
                {
                    "data_path": "action_result.data.*.final_answer",
                    "data_type": "string",
                    "column_name": "Final Answer",
                    "column_order": 1
                },
                {
                    "data_path": "action_result.data.*.steps_taken",
                    "data_type": "numeric",
                    "column_name": "Steps",
                    "column_order": 2
                },
                {
                    "data_path": "action_result.data.*.provider",
                    "data_type": "string",
                    "column_name": "Provider",
                    "column_order": 3
                },
                {
                    "data_path": "action_result.data.*.model",
                    "data_type": "string",
                    "column_name": "Model",
                    "column_order": 4
                },
                {
                    "data_path": "action_result.data.*.step_log",
                    "data_type": "string",
                    "column_name": "Step Log",
                    "column_order": 5
                }
            ],
            "versions": "EQ(*)"
        },
        {
            "action": "create agent",
            "identifier": "create_agent",
            "description": "Creates or updates an agent definition in the agent_definitions Custom List",
            "type": "generic",
            "read_only": false,
            "parameters": {
                "agent_id": {
                    "description": "Unique agent identifier",
                    "data_type": "string",
                    "required": true,
                    "order": 0
                },
                "system_prompt": {
                    "description": "System prompt defining the agent's role and behaviour",
                    "data_type": "string",
                    "required": true,
                    "order": 1
                },
                "provider": {
                    "description": "LLM provider: anthropic | openai | gemini | local",
                    "data_type": "string",
                    "required": true,
                    "order": 2
                },
                "model": {
                    "description": "Model name (e.g. claude-sonnet-4-5, gpt-4o, gemini-2.0-flash, llama3)",
                    "data_type": "string",
                    "required": true,
                    "order": 3
                },
                "allowed_tools": {
                    "description": "Comma-separated list of allowed tools: add_note, update_severity, get_container_info, run_sub_agent, splunk_search (deprecated; disabled in airgap_mode, use Tool Broker templates via broker_invoke instead). Default: add_note",
                    "data_type": "string",
                    "required": false,
                    "default": "add_note",
                    "order": 4
                },
                "max_steps": {
                    "description": "Maximum ReAct loop steps for this agent (0 = use app default)",
                    "data_type": "numeric",
                    "required": false,
                    "default": 0,
                    "order": 5
                },
                "skills": {
                    "description": "Comma-separated skill IDs to attach (e.g. mitre_mapping,german_output)",
                    "data_type": "string",
                    "required": false,
                    "default": "",
                    "order": 6
                },
                "agent_role": {
                    "description": "Role this agent plays. Groups the Agent Precision panel in AI-SOC Telemetry, so use the fixed values only.",
                    "data_type": "string",
                    "required": false,
                    "default": "generic",
                    "value_list": [
                        "triage",
                        "enrichment",
                        "response",
                        "generic"
                    ],
                    "order": 7
                }
            },
            "output": [
                {
                    "data_path": "action_result.data.*.agent_id",
                    "data_type": "string",
                    "column_name": "Agent ID",
                    "column_order": 0
                },
                {
                    "data_path": "action_result.data.*.status",
                    "data_type": "string",
                    "column_name": "Status",
                    "column_order": 1
                }
            ],
            "versions": "EQ(*)"
        },
        {
            "action": "list agents",
            "identifier": "list_agents",
            "description": "Lists all agent definitions from the agent_definitions Custom List",
            "type": "investigate",
            "read_only": true,
            "parameters": {},
            "output": [
                {
                    "data_path": "action_result.data.*.agent_id",
                    "data_type": "string",
                    "column_name": "Agent ID",
                    "column_order": 0
                },
                {
                    "data_path": "action_result.data.*.provider",
                    "data_type": "string",
                    "column_name": "Provider",
                    "column_order": 1
                },
                {
                    "data_path": "action_result.data.*.model",
                    "data_type": "string",
                    "column_name": "Model",
                    "column_order": 2
                },
                {
                    "data_path": "action_result.data.*.allowed_tools",
                    "data_type": "string",
                    "column_name": "Allowed Tools",
                    "column_order": 3
                },
                {
                    "data_path": "action_result.data.*.max_steps",
                    "data_type": "numeric",
                    "column_name": "Max Steps",
                    "column_order": 4
                },
                {
                    "data_path": "action_result.data.*.skills",
                    "data_type": "string",
                    "column_name": "Skills",
                    "column_order": 5
                },
                {
                    "data_path": "action_result.data.*.agent_role",
                    "data_type": "string",
                    "column_name": "Role",
                    "column_order": 6
                }
            ],
            "versions": "EQ(*)"
        },
        {
            "action": "create skill",
            "identifier": "create_skill",
            "description": "Creates or updates a skill in the agent_skills Custom List",
            "type": "generic",
            "read_only": false,
            "parameters": {
